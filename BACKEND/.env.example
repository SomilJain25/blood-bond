# Copy to .env and fill in. NEVER commit .env.
# Local: SQLite file (no server needed). Start uvicorn from the BACKEND folder.
# Production: postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@HOST:5432/DBNAME
# Full guide: ENV_GUIDE.md
DATABASE_URL=sqlite:///./bloodconnect.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_GEOFENCE_KM=25

# Comma-separated 10-digit phones allowed to log in as admin
ADMIN_PHONES=

# DEMO_MODE=true  -> OTP is a fixed code returned by the API (hackathon demo ONLY).
# DEMO_MODE=false -> real OTP by SMS; requires SECRET_KEY to be changed and SMS_PROVIDER=msg91.
DEMO_MODE=true
DEMO_OTP_CODE=123456

# --- SMS (MSG91) ---------------------------------------------------------
# SMS_PROVIDER=none keeps everything local (messages are only logged).
SMS_PROVIDER=none
SMS_COUNTRY_CODE=91
MSG91_AUTHKEY=
# Template ids from the MSG91 dashboard (India: templates must be DLT-approved).
MSG91_OTP_TEMPLATE_ID=
MSG91_DONOR_ALERT_TEMPLATE_ID=
MSG91_HOSPITAL_ACCEPT_TEMPLATE_ID=
MSG91_BROADCAST_TEMPLATE_ID=

# --- Hospital verification ------------------------------------------------
# false (default): any registered hospital can raise requests; admins can still verify them.
# true: only hospitals verified in the admin dashboard may raise requests.
REQUIRE_VERIFIED_HOSPITALS=false
